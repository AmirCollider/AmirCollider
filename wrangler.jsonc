{
  // ==========================================
  // Cloudflare Worker configuration - amircollider
  //
  // The version the site reports lives in CONFIG.VERSION
  // (Config.js), which is the one place it is written down.
  // ==========================================
  "name": "amircollider",
  "main": "Worker.js",
  "compatibility_date": "2025-08-03",

  // ==========================================
  // Do not wipe what this file does not know about.
  //
  // Wrangler's default is keep_vars: false, and "false" means
  // the deploy REPLACES the Worker's variables with the set
  // declared here. Nothing is declared here - every secret on
  // this Worker was added out of band - so a deploy from this
  // config removes any variable that was added through the
  // Cloudflare dashboard.
  //
  // That is what happened on 2026-08-13: CHRONOBLADES_GOOGLE_
  // CLIENT_ID_WEB and _SECRET were set in the dashboard, the
  // next deploy took them away, and because validateEnvironment()
  // in Config.js treats those two as required for a game that
  // signs players in, the whole Worker would have started
  // answering 500 - not just Chrono Blades.
  //
  // Secrets put with `npx wrangler secret put` were never at
  // risk. This line protects the dashboard-set ones, which is
  // the case that actually bit.
  // ==========================================
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "NEON_KATANA_DB",
      "database_name": "neon-katana-db",
      "database_id": "790fc372-1b4d-4e5a-996f-bf92cde2d19c"
    },
    {
      "binding": "CHRONOBLADES_DB",
      "database_name": "chronoblades-db",
      "database_id": "90733250-c9e3-4430-8d56-46d74773750e"
    },
    {
      "binding": "LICENSE_DB",
      "database_name": "amircollider-licenses",
      "database_id": "7ddcf78a-8de1-47d4-899d-9ca72b903b68"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "amircolliderr2"
    }
  ],

  // Cron - the checkout's safety net. Every five minutes the
  // scheduled handler retries an undelivered licence email,
  // resumes a paid-but-undelivered order, and asks the payment
  // provider about invoices whose callback never arrived.
  //
  // Five minutes because that is the delivery promise on the pay
  // page and in the "it never arrived" email. A longer interval
  // would make the page lie; a shorter one buys nothing, because
  // the happy path delivers in seconds and never waits for this.
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
