{
  // ==========================================
  // Cloudflare Worker Config - amircollider
  // AmirCollider Games - OAuth Proxy v6.7.1
  // ==========================================
  "name": "amircollider",
  "main": "worker.js",
  "compatibility_date": "2025-08-03",
  "d1_databases": [
    {
      "binding": "NEON_KATANA_DB",
      "database_name": "neon-katana-db",
      "database_id": "790fc372-1b4d-4e5a-996f-bf92cde2d19c"
    },
    {
      "binding": "LICENSE_DB",
      "database_name": "amircollider-licenses",
      "database_id": "7ddcf78a-8de1-47d4-899d-9ca72b903b68"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "amircolliderr2"
    }
  ],

  // ==========================================
  // Cron - the checkout's safety net
  //
  // Every five minutes, the Worker's scheduled handler
  // retries any licence email that has not gone out, resumes
  // any order that was paid for and not delivered, and asks
  // the payment provider about invoices whose callback never
  // arrived.
  //
  // Five minutes because that is the delivery promise made
  // on the pay page and quoted in the "it never arrived"
  // email template. A longer interval would make the page
  // lie; a shorter one buys nothing, because the happy path
  // delivers in seconds and never waits for this at all.
  // ==========================================
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
